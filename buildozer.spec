[app]

# (str) Title of your application
title = NORMI Campus Navigation

# (str) Package name
package.name = norminavigation

# (str) Package domain
package.domain = org.normi

# (str) Source code directory
source.dir = .

# (str) Main Python file
source.main = main.py

# (str) Application version
version = 1.0

# (str) Requirements
requirements = python3,kivy

# (str) Supported orientation
orientation = portrait

# (str) Files to include
source.include_exts = py,png,jpg,jpeg

# (str) Android API target
android.api = 35

# (str) Android minimum API
android.minapi = 21

# (str) Android architecture
android.archs = arm64-v8a

# (str) Keep Python files
source.exclude_exts = spec

[buildozer]

# (str) Log level
log_level = 2
